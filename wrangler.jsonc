{
  // One Worker serves the site (public/) and every topic's API (/api/<topic>/...).
  // Rename the Worker and set your domain before the first deploy.
  "name": "lnl",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] }
  // "routes": [{ "pattern": "lnl.example.com", "custom_domain": true }]
}
