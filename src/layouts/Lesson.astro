---
// A lesson page: chips for every lesson in its topic on top, "Next" and the footer at the bottom.
// Topics and lessons are listed in one place, src/site.json; nothing else repeats them.
import site from '../site.json';
import Base from './Base.astro';

interface Props {
  title: string;
  prose?: boolean;
}
const { title, prose } = Astro.props;
const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const topic = site.topics.find((t) => t.lessons.some((l) => l.path === here));
if (!topic) throw new Error(`${here} is not listed in src/site.json`);
const index = topic.lessons.findIndex((l) => l.path === here);
const next = topic.lessons[index + 1];
---

<Base title={`${title} · ${site.title}`} mainClass={prose ? 'prose' : undefined}>
  <nav class="chips" aria-label={`${topic.title} lessons`}>
    <a href="/">← Home</a>
    {
      topic.lessons.map((l) => (
        <a href={l.path} aria-current={l.path === here ? 'page' : undefined}>
          {l.chip ?? l.title}
        </a>
      ))
    }
  </nav>
  <slot />
  {next && <p class="next">Next: <a href={next.path}>{next.title} →</a></p>}
  <footer>Made by <a href={site.author.url}>{site.author.name}</a>.</footer>
</Base>

<script>
  // On a phone, open the chip row scrolled to this lesson.
  const nav = document.querySelector<HTMLElement>('.chips');
  const current = nav?.querySelector<HTMLElement>('[aria-current="page"]');
  if (nav && current) nav.scrollLeft = current.offsetLeft - nav.offsetLeft - 18;
</script>
