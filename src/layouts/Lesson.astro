---
// A lesson page: its topic's lessons as chips in the page header, the lesson, then a link to the next one.
// Topics and lessons are listed in one place, src/site.json; nothing else repeats them.
import site from '../site.json';
import Base from './Base.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const topic = site.topics.find((t) => t.lessons.some((l) => l.path === here));
if (!topic) throw new Error(`${here} is not listed in src/site.json`);
const index = topic.lessons.findIndex((l) => l.path === here);
const next = topic.lessons[index + 1];
---

<Base title={`${title} · ${site.title}`}>
  <nav class="cluster" slot="nav" aria-label={`${topic.title} lessons`}>
    {
      topic.lessons.map((l) => (
        <a
          class:list={['chip', { selected: l.path === here }]}
          href={l.path}
          aria-current={l.path === here ? 'page' : undefined}
        >
          {l.chip ?? l.title}
        </a>
      ))
    }
  </nav>
  <slot />
  {next && <p>Next: <a href={next.path}>{next.title} →</a></p>}
</Base>
