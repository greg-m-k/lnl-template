---
// Home: a header, then one section of cards per topic, from src/site.json.
import Base from '../layouts/Base.astro';
import site from '../site.json';

export const prerender = true;
---

<Base
  title={site.title}
  description="Interactive Lunch & Learn lessons: competing patterns, really running, side by side."
>
  <header class="stack">
    <h1>{site.title}</h1>
    <p>{site.intro}</p>
    <p>
      {site.origin.text} <a href={site.origin.url}>{new URL(site.origin.url).host}</a>.
    </p>
  </header>
  {
    site.topics.map((t) => (
      <section class="stack" aria-labelledby={`topic-${t.slug}`}>
        <h2 id={`topic-${t.slug}`}>
          <span aria-hidden="true">{t.emoji}</span> {t.title}
        </h2>
        <p>
          {t.summary}{' '}
          {site.repo ? (
            <span>
              <a href={`${site.repo}/tree/main/${t.source}`}>The source for this topic is on GitHub</a>.
            </span>
          ) : (
            <span>
              The source for this topic is in <code>{t.source}</code>.
            </span>
          )}
        </p>
        <div class="layout-card">
          {t.lessons.map((l) => (
            <a class="card linked" href={l.path}>
              <h3 class="h5">{l.title}</h3>
              <p>{l.blurb}</p>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Base>
